{
  "name": "client-portal-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:worker": "npm --workspace apps/worker run dev",
    "db:seed": "prisma db seed",
    "build:web": "npm --workspace apps/web run build",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "test": "turbo test",
    "prepare": "husky install"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "tsx": "^4.16.2",
    "prettier": "^3.2.5",
    "turbo": "^2.0.3",
    "typescript": "^5.4.5",
    "prisma": "^5.16.2"
  }
}
